/* 全局样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

.container {
  padding: 20rpx;
}

/* 通用按钮样式 */
.btn-primary {
  background-color: #07c160;
  color: white;
  border: none;
}

.btn-primary:active {
  background-color: #06ad56;
}

.btn-danger {
  background-color: #fa5151;
  color: white;
  border: none;
}

.btn-danger:active {
  background-color: #e84545;
}

/* 通用文本样式 */
.text-gray {
  color: #999;
}

.text-primary {
  color: #07c160;
}

/* 通用布局样式 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-1 {
  flex: 1;
}
