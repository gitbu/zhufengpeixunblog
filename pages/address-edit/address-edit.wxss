.container {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 表单容器 */
.form-container {
  background-color: white;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 表单项 */
.form-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.form-input {
  font-size: 28rpx;
  color: #333;
  width: 100%;
}

.form-input.placeholder {
  color: #999;
}

.form-textarea {
  font-size: 28rpx;
  color: #333;
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  box-sizing: border-box;
}

/* Switch 表单项 */
.form-item-switch {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 按钮 */
.button-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background-color: white;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.save-button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 44rpx;
}
