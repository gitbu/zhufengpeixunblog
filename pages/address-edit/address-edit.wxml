<view class="container">
  <view class="form-container">
    <!-- 收货人 -->
    <view class="form-item">
      <view class="form-label">收货人</view>
      <input class="form-input" placeholder="请输入收货人姓名" value="{{formData.name}}" bindinput="onInputChange" data-field="name" />
    </view>

    <!-- 手机号码 -->
    <view class="form-item">
      <view class="form-label">手机号码</view>
      <input class="form-input" type="number" placeholder="请输入手机号码" value="{{formData.phone}}" bindinput="onInputChange" data-field="phone" maxlength="11" />
    </view>

    <!-- 地址标签 -->
    <view class="form-item">
      <view class="form-label">地址标签</view>
      <view class="tag-list">
        <view
          class="tag-item {{formData.tag === item ? 'active' : ''}}"
          wx:for="{{tagList}}"
          wx:key="index"
          bindtap="onTagSelect"
          data-tag="{{item}}">
          {{item}}
        </view>
      </view>
    </view>

    <!-- 所在地区 -->
    <view class="form-item" bindtap="onRegionChange">
      <view class="form-label">所在地区</view>
      <picker mode="region" value="{{region}}" bindchange="onRegionPicked" custom-item="{{customItem}}">
        <view class="form-input {{!formData.province ? 'placeholder' : ''}}">
          {{formData.province ? formData.province + ' ' + formData.city + ' ' + formData.district : '请选择省市区'}}
        </view>
      </picker>
    </view>

    <!-- 详细地址 -->
    <view class="form-item">
      <view class="form-label">详细地址</view>
      <textarea class="form-textarea" placeholder="街道、楼牌号等" value="{{formData.detail}}" bindinput="onInputChange" data-field="detail" maxlength="200" />
    </view>

    <!-- 设为默认地址 -->
    <view class="form-item-switch">
      <view class="form-label">设为默认地址</view>
      <switch checked="{{formData.isDefault}}" bindchange="onSwitchChange" color="#07c160" />
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="button-wrapper">
    <button class="save-button btn-primary" bindtap="onSave">保存</button>
  </view>
</view>
